# ===========================================================================
# Restore Marketing Co Automation — Credentials Template
# ===========================================================================
# Copy this file to .env (same directory) and fill in real values.
# .env is in .gitignore — it will NEVER be committed. Verify with:
#     git check-ignore -v .env
#
# NEVER commit real credentials. Rotate anything that leaks immediately.
# ===========================================================================

# ---------------------------------------------------------------------------
# GoHighLevel (GHL) — primary integration
# ---------------------------------------------------------------------------
# Get an access token from:
#   Agency Settings → API Key → Generate Access Token (v2 OAuth)
# OR for simpler private integrations:
#   Location Settings → Business → Private Integrations → Generate API Key
#
# location_id is the sub-account ID. For Restore Marketing Co's own
# automation, use the agency's OWN location (not a client sub-account).

GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
# Optional — only override if using a custom domain or testing endpoint
# GHL_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28

# Force mock mode (useful for CI or offline testing)
# GHL_MOCK=1

# ---------------------------------------------------------------------------
# Video generation (Seedance 2.0 + LTX-2.3 via fal.ai)
# ---------------------------------------------------------------------------
# Both models are wrapped in scripts/adapters/video.py with a VideoRouter
# that auto-picks the best provider per use case:
#   - portrait short-form (Reels/TikTok/Shorts) -> LTX-2.3 fast/distilled
#   - cinematic ads with audio                  -> Seedance 2.0
#   - 4K hero / long-form                       -> LTX-2.3 pro
#   - image-to-video product showcase           -> Seedance 2.0
#
# Get a fal.ai API key: https://fal.ai/dashboard/keys
# Pricing: ~$0.04/sec for LTX fast 1080p, ~$0.05 per 5-sec Seedance 720p,
# up to ~$0.24/sec for LTX pro 4K. Start with FAL_KEY missing (mock mode)
# until you're ready to burn real generation credits.

FAL_KEY=

# Optional — override model endpoint slugs if fal.ai renames them
# FAL_SEEDANCE_MODEL=fal-ai/bytedance/seedance-2.0
# FAL_LTX_MODEL=fal-ai/ltx-video-2.3
# FAL_LTX_FAST_MODEL=fal-ai/ltx-video-2.3/fast
# FAL_LTX_PRO_MODEL=fal-ai/ltx-video-2.3/pro
# FAL_LTX_DISTILLED_MODEL=fal-ai/ltx-video-2.3/distilled

# Force mock mode (useful for CI or offline testing)
# VIDEO_MOCK=1

# ---------------------------------------------------------------------------
# Fallback email (if not using GHL's native email for transactional)
# ---------------------------------------------------------------------------
# Only needed if you want to use a secondary provider for high-deliverability
# transactional mail (invoices, payment receipts). Most agencies can skip this
# and use GHL's native email.

# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

# ---------------------------------------------------------------------------
# Analytics (optional — for client-facing reports beyond GHL's own)
# ---------------------------------------------------------------------------
# GHL has basic analytics; if you want to pull GA4 or Plausible data for
# client reports, set these.

# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_JSON_PATH=
# PLAUSIBLE_API_KEY=

# ---------------------------------------------------------------------------
# Storage (optional — for large client files outside GHL)
# ---------------------------------------------------------------------------
# GHL has limited file storage. If you need to share large deliverables,
# consider a secondary store.

# GOOGLE_DRIVE_CREDENTIALS_JSON_PATH=
# DROPBOX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Messaging / alerts (optional — where agent escalations go)
# ---------------------------------------------------------------------------
# If you want escalations to hit Slack instead of vault-only:

# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_ALERT_CHANNEL=#restore-automation-alerts
