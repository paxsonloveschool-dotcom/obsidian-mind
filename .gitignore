# Obsidian (runtime state, not vault config)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/*/data.json
.obsidian/graph.json

# OS
.DS_Store
.Trash/

# Claude Code (local settings are personal)
.claude/settings.local.json

# QMD index (local, regenerated)
.qmd/

# Session logs (local transcripts)
thinking/session-logs/

# Python bytecode / coverage (from vendored skills)
__pycache__/
*.pyc
.coverage

# Credentials — NEVER commit these
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
service-account-*.json

# Adapter logs (local observability, regenerated)
work/active/*/runs/

# Generated automation artifacts (local, produced on every run)
work/active/*/social-video-batches/
work/active/*/proposals/
work/active/*/invoices/
work/active/*/reports/
work/active/*/engagements/
work/active/*/leads/
