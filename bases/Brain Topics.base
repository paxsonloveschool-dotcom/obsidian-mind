filters:
  and:
    - file.inFolder("brain")
    - '!file.inFolder("brain/playbooks")'
    - file.ext == "md"
formulas:
  inbound_count: file.backlinks.length
  age_days: if(file.mtime, (today() - date(file.mtime)).days, "")
properties:
  file.name:
    displayName: Topic
  description:
    displayName: Contents
  formula.inbound_count:
    displayName: References
  file.mtime:
    displayName: Updated
  formula.age_days:
    displayName: Age (days)
views:
  - type: table
    name: All Brain Topics
    order:
      - file.name
      - description
      - formula.inbound_count
      - file.mtime
  - type: table
    name: By Reference Count
    order:
      - file.name
      - formula.inbound_count
      - description
  - type: table
    name: Stale (30+ days)
    filters:
      and:
        - formula.age_days > 30
    order:
      - formula.age_days
      - file.name
      - description
